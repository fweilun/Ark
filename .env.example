# Ark Backend Environment Variables
# Copy this file to .env and fill in the values.

# --- HTTP server ---
# Listen address for the API server. `:8080` binds to all interfaces on port 8080.
ARK_HTTP_ADDR=:8080
# Public host (+ optional port) used by Swagger UI to build the "Try it out" URL.
# Leave empty locally — defaults to `localhost:8080`. Set to e.g. `api.zooark.example.com` in deployed envs.
PUBLIC_HOST=

# --- Datastores ---
# Postgres connection string used by the app (mirrors DATABASE_URL in other stacks).
ARK_DB_DSN=postgres://postgres:postgres@localhost:5432/ark?sslmode=disable
# Redis host:port (mirrors REDIS_ADDR / REDIS_URL in other stacks).
ARK_REDIS_ADDR=localhost:6379

# --- Matching engine ---
# Seconds between matching scheduler ticks.
ARK_MATCH_TICK=3
# Max radius (km) to search for nearby drivers per tick.
ARK_MATCH_RADIUS_KM=3.0

# --- Third-party APIs ---
# Google Gemini API key — REQUIRED; server fails to start if empty.
GEMINI_API_KEY=
# Google Maps API key — used for geocoding in the ride assistant; optional.
GOOGLE_MAPS_API_KEY=

# --- Firebase ---
# Firebase service account credentials as a JSON string (paste the whole file contents on one line).
# Required for auth middleware, FCM push notifications, and Realtime Database access.
# If empty, auth middleware is disabled (dev mode only) and push/RTDB features will error at runtime.
FIREBASE_CREDENTIALS_JSON=

# --- Integration tests / benchmark runner (optional) ---
# Postgres DSN for tests; falls back to ARK_DB_DSN when unset.
ARK_TEST_DSN=
# Alternate test DSN read by calendar/order store tests.
TEST_DB_DSN=
# Base URL for the integration-test HTTP client.
ARK_API_BASE_URL=
# cmd/bench settings — benchmark runner against a live API.
ARK_BENCH_BASE_URL=http://localhost:8080
ARK_BENCH_MIGRATION=migrations/0001_init.sql
ARK_BENCH_APPLY_MIGRATION=false
ARK_BENCH_STRICT=false
ARK_BENCH_TIMEOUT=60s
ARK_BENCH_CONCURRENCY=20
ARK_BENCH_DURATION=10s
